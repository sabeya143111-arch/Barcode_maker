# Streamlit Secrets Configuration Template
# Copy this file to 'secrets.toml' and fill in your actual values
# DO NOT commit the actual secrets.toml file to GitHub

[email]
# Gmail account from which OTP emails will be sent
SMTP_EMAIL = "your-email@gmail.com"

# Gmail App Password (NOT your regular Gmail password)
# To generate: https://myaccount.google.com/apppasswords
SMTP_PASSWORD = "your-16-character-app-password"

# SMTP server settings (default for Gmail)
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = 587
